[Unit]
Description=Validate and push the current ProofEdge public snapshot
After=network-online.target proof-edge-recorder.service
Wants=network-online.target
OnFailure=proof-edge-evidence-alert.service

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/ChatGPT/Somnia_Hack
Environment=RECORDER_STORE=data/forecast-events.jsonl
ExecStart=/usr/bin/npm run publish:auto
NoNewPrivileges=true
PrivateTmp=true
