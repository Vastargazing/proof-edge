[Unit]
Description=Proof Edge Somnia forecast recorder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/va/Documents/ChatGPT/Somnia_Hack
Environment=VENUE_ID=0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c
Environment=EMITTER_ADDRESS=0x3020c7ea249b6be98d0e9acf911eaeeb766ace4f
Environment=RECORDER_STORE=/home/va/Documents/ChatGPT/Somnia_Hack/data/forecast-events.jsonl
ExecStart=/usr/bin/node --env-file=/home/va/.config/proof-edge/wallet.env --import tsx src/live-recorder.ts
Restart=always
RestartSec=8
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
