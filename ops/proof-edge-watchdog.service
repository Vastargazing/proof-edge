[Unit]
Description=Check ProofEdge recorder, window, anchor, and ledger liveness
After=proof-edge-recorder.service
OnFailure=proof-edge-watchdog-alert.service

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/ChatGPT/Somnia_Hack
Environment=RECORDER_STORE=data/forecast-events.jsonl
Environment=WATCHDOG_STATE=%h/.local/state/proof-edge/watchdog.json
# Seven ticks (70 min) while DreamDEX lists only hourly windows; two sufficed
# while the five-minute series ran. Stall and stale-input checks are separate.
Environment=WATCHDOG_STALE_TICKS=7
Environment=WATCHDOG_HEARTBEAT_STALE_MS=900000
Environment=WATCHDOG_SPOT_STALE_MS=900000
Environment=WATCHDOG_MAX_AUTO_RESTARTS=2
Environment=WATCHDOG_RESTART_GRACE_TICKS=3
ExecStart=/usr/bin/node --import tsx scripts/watchdog.ts
NoNewPrivileges=true
PrivateTmp=true
